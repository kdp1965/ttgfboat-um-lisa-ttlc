{
  "//": "PDN_CFG: LibreLane's PDN plus a Metal4 stripe (with pdngen's vias to the rails) on each macro power pin column that is not on a tile stripe (none, at x 740.77); Tile.ExtendPowerStripes then runs the columns over the macro.",
  "REMOVE_SOURCES": [
    "RAM32.v"
  ],
  "PL_TARGET_DENSITY_PCT": 85,
  "GRT_ANTENNA_REPAIR_ITERS": 5,
  "DRT_ANTENNA_REPAIR_ITERS": 5,
  "FP_MACRO_HORIZONTAL_HALO": 2,
  "FP_MACRO_VERTICAL_HALO": 1,
  "FP_PRUNE_THRESHOLD": 11,
  "ERROR_ON_PDN_VIOLATIONS": false,
  "PDN_CFG": "dir::pdn_macro.tcl",
  "PDN_MACRO_CONNECTIONS": [
    "ram1 VPWR VGND VPWR VGND"
  ],
  "MACROS": {
    "RAM32": {
      "instances": {
        "ram1": {
          "location": [
            740.77,
            3.92
          ],
          "orientation": "N"
        }
      },
      "gds": [
        "dir::../macros/RAM32.gds"
      ],
      "lef": [
        "dir::../macros/RAM32.lef"
      ],
      "nl": [
        "dir::../macros/RAM32.nl.v"
      ],
      "spef": {
        "min_*": [
          "dir::../macros/RAM32.min_.spef"
        ],
        "nom_*": [
          "dir::../macros/RAM32.nom_.spef"
        ],
        "max_*": [
          "dir::../macros/RAM32.max_.spef"
        ]
      },
      "lib": {
        "nom_tt_025C_3v30": "dir::../macros/RAM32.lib/nom_tt_025C_3v30/RAM32__nom_tt_025C_3v30.lib",
        "nom_ss_125C_3v00": "dir::../macros/RAM32.lib/nom_ss_125C_3v00/RAM32__nom_ss_125C_3v00.lib",
        "nom_ff_n40C_3v60": "dir::../macros/RAM32.lib/nom_ff_n40C_3v60/RAM32__nom_ff_n40C_3v60.lib",
        "min_tt_025C_3v30": "dir::../macros/RAM32.lib/min_tt_025C_3v30/RAM32__min_tt_025C_3v30.lib",
        "min_ss_125C_3v00": "dir::../macros/RAM32.lib/min_ss_125C_3v00/RAM32__min_ss_125C_3v00.lib",
        "min_ff_n40C_3v60": "dir::../macros/RAM32.lib/min_ff_n40C_3v60/RAM32__min_ff_n40C_3v60.lib",
        "max_tt_025C_3v30": "dir::../macros/RAM32.lib/max_tt_025C_3v30/RAM32__max_tt_025C_3v30.lib",
        "max_ss_125C_3v00": "dir::../macros/RAM32.lib/max_ss_125C_3v00/RAM32__max_ss_125C_3v00.lib",
        "max_ff_n40C_3v60": "dir::../macros/RAM32.lib/max_ff_n40C_3v60/RAM32__max_ff_n40C_3v60.lib"
      }
    }
  },
  "EXTRA_VERILOG_MODELS": [
    "dir::../src/RAM32.v"
  ]
}
